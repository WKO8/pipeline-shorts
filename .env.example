# ===== YouTube download =====
# Prefer H.264/MP4 to avoid AV1 decode issues on some systems.
YTDLP_FORMAT=bestvideo[vcodec*=avc1]+bestaudio[acodec*=mp4a]/best[ext=mp4]/best

# ===== Whisper / Transcription (RTX 3050 8GB Optimized) =====
# Model options: tiny, base, small, medium, large-v3, large-v3-turbo
WHISPER_MODEL=large-v3-turbo
# Device: auto, cpu, cuda
WHISPER_DEVICE=cuda
# Compute type examples: int8, int8_float16, float16, float32
WHISPER_COMPUTE_TYPE=int8_float16
# Main language for better accuracy
WHISPER_LANGUAGE=pt
# Enable word-level timestamps (required for dynamic captions)
WHISPER_WORD_TIMESTAMPS=true
# Stage-1 (transcription + semantic curation) em CPU para poupar VRAM (desativado para usar GPU)
STAGE1_CPU_ONLY=false
# Permite fallback heurístico quando o LLM não retorna JSON válido
ALLOW_HEURISTIC_FALLBACK=false

# ===== Curator Provider Selection =====
# Options: auto (DeepSeek com fallback automático Gemini 3.8 Flash), deepseek, gemini, ollama
CURATOR_PROVIDER=ollama

# ===== DeepSeek / Cloud LLM Curation (Primary High-Reasoning) =====
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Model options: deepseek-v4-flash-vision-exp (suporte a visão multimodal de frames), deepseek-v4.1-flash
DEEPSEEK_MODEL_NAME=deepseek-v4-flash-vision-exp
# Reasoning effort: 50 (low), 75 (high, recomendado), 100 (max)
DEEPSEEK_REASONING_EFFORT=75

# ===== Gemini / Cloud LLM Curation (Fast & Resilient Fallback) =====
GOOGLE_API_KEY=
GOOGLE_MODEL_NAME=gemini-3.8-flash

# ===== Virality Analysis & Social Platforms =====
# YouTube Data API v3 & Analytics (Shorts auditing)
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:7860/api/virality/youtube/callback

# TikTok for Developers (Login Kit & Display API)
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=http://localhost:7860/api/virality/tiktok/callback

# ===== Ollama / Local LLM curation =====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
# How many clips to request from LLM
OLLAMA_CLIPS_COUNT=5
# Target clip duration limits (seconds)
CLIP_MIN_SECONDS=30
CLIP_MAX_SECONDS=60
CLIP_MIN_GAP_SECONDS=60
# Temperature for deterministic structured output
OLLAMA_TEMPERATURE=0.2
# Max timeout for local model response
OLLAMA_TIMEOUT_SECONDS=240
# Virality floor (0-10) para priorizar cortes fortes
VIRALITY_MIN_SCORE=8.5
# Janela para reposicionar início no gancho
HOOK_SEARCH_WINDOW_SECONDS=8.0
# Janela para ajustar final em boundary narrativa
STORY_ARC_WINDOW_SECONDS=10.0

# ===== Video processing =====
# Final output resolution for shorts
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
OUTPUT_FPS=30

# If true, track face and keep it centered in the top area
ENABLE_FACE_TRACKING=true

# Top area ratio reserved for speaker video (0.0 - 1.0)
TOP_REGION_RATIO=0.58
# Bottom area ratio reserved for background/gameplay
BOTTOM_REGION_RATIO=0.42
# Dynamic tracking smoothing window (frames)
TRACKING_WINDOW_FRAMES=30
# Eased pan/scan alpha (0.01-1.0)
TRACKING_EASE_ALPHA=0.15
# Eye-line lock position (0.30 = eyes at 30% from top)
TRACKING_EYE_LINE_RATIO=0.30
# Face confidence threshold: below this, renderer switches to fit-scene + blurred background
TRACKING_CONFIDENCE_THRESHOLD=0.65
# Face "in focus" threshold (largura mínima relativa do rosto no frame)
TRACKING_FOCUS_MIN_WIDTH_RATIO=0.14
# Proxy visual de fala ativa (abertura de boca / altura do rosto)
TRACKING_SPEAKING_MOUTH_OPEN_THRESHOLD=0.018
# Zona morta anti-jitter (px): ignora micro movimentos do detector
TRACKING_JITTER_DEADZONE_PX=8.0
# Limite de velocidade de pan/crop para reduzir tremedeira (px/s)
TRACKING_MAX_PAN_SPEED_PX_PER_S=900.0
# Janela mínima (s) para ativar duo-split dinâmico dentro do clipe
MULTIFACE_WINDOW_MIN_SECONDS=0.20
# Gap máximo (s) para fundir janelas consecutivas de duo-split
MULTIFACE_WINDOW_MERGE_GAP_SECONDS=0.22
# Padding (s) em torno do frame ativo para evitar perder diálogos curtos
MULTIFACE_WINDOW_PADDING_SECONDS=0.35
# Janelas do modo single quando há falante visível ativo em cena (para alternar entre fit e tracking)
SINGLE_WINDOW_MIN_SECONDS=0.35
SINGLE_WINDOW_MERGE_GAP_SECONDS=0.30
SINGLE_WINDOW_PADDING_SECONDS=0.30
# Auto duo-split quando há 2+ rostos sustentados na cena
MULTIFACE_DUO_SPLIT_THRESHOLD=0.22
# Desativa zoom em cenas com múltiplos rostos para manter visibilidade
MULTIFACE_DISABLE_ZOOM_THRESHOLD=0.14
# Slow zoom step per frame (0.001 = 0.1% / frame)
ZOOM_PER_FRAME=0.001
# Maximum zoom multiplier for long monologues
ZOOM_MAX_SCALE=1.18
# Minimum clip length (seconds) to enable slow zoom
ZOOM_MIN_DURATION_SECONDS=8.0
# Punch-in zoom scale para palavras de ênfase
EMPHASIS_ZOOM_SCALE=1.15
# Duração do punch-in (segundos)
EMPHASIS_ZOOM_DURATION_SECONDS=0.9
# Máximo de punch-ins por clipe
EMPHASIS_ZOOM_MAX_EVENTS=6
# Zoom de jump-cut para mudança de assunto
TOPIC_JUMP_ZOOM_SCALE=1.10
TOPIC_JUMP_DURATION_SECONDS=0.45
TOPIC_JUMP_MAX_EVENTS=4
# Static-scene pulse zoom (every 5s)
STATIC_PULSE_ZOOM_SCALE=1.10
STATIC_PULSE_INTERVAL_SECONDS=4.0
STATIC_PULSE_DURATION_SECONDS=0.8
STATIC_MOTION_THRESHOLD=3.5

# ===== Background (optional) =====
# Path to a local looping background video (ex: assets/backgrounds/gta.mp4)
BACKGROUND_VIDEO_PATH=
# If empty, pipeline can generate plain/blurred background fallback
BACKGROUND_FALLBACK_MODE=blur
# Persistent UI overlays (aplicados no último estágio do filter graph)
TOP_BANNER_PATH=
BOTTOM_LOGO_PATH=
TOP_BANNER_MARGIN=20
BOTTOM_LOGO_MARGIN=24
TOP_BANNER_MAX_WIDTH=1080
BOTTOM_LOGO_MAX_WIDTH=320
# Contextual overlays (memes/GIFs) ancorados no peito
CONTEXTUAL_OVERLAY_CHEST_OFFSET=400
CONTEXTUAL_OVERLAY_MAX_WIDTH=420

# ===== Captions style =====
CAPTIONS_ENABLED=true
CAPTIONS_FONT=Arial-Bold
CAPTIONS_FONT_SIZE=64
CAPTIONS_COLOR=#FFFFFF
CAPTIONS_ACTIVE_WORD_COLOR=#FFD400
CAPTIONS_STROKE_COLOR=#000000
CAPTIONS_STROKE_WIDTH=3
CAPTIONS_POSITION=bottom
CAPTIONS_KEYWORD_COLOR_A=#E5A50A
CAPTIONS_KEYWORD_COLOR_B=#FFA348
CAPTIONS_POPUP_PEAK_FRAMES=3
CAPTIONS_POPUP_SETTLE_FRAMES=6
CAPTIONS_SHORT_PHRASE_MAX_WORDS=4
CAPTIONS_KEYWORD_GLOW_BLUR=1.2
CAPTIONS_HOOK_FIRST_SCALE=155
CAPTIONS_HOOK_FIRST_COLOR=#E01B24
# Burn captions directly into rendered clip video
CAPTIONS_BURN_IN_VIDEO=true
# Export caption-only transparent 9:16 overlay video (.mov)
CAPTIONS_EXPORT_OVERLAY_VIDEO=false
CAPTIONS_OVERLAY_VIDEO_CODEC=qtrle
CAPTIONS_OVERLAY_VIDEO_EXT=mov

# ===== Encoding / GPU =====
# Use NVENC on NVIDIA GPU (GTX 1660 Super supported)
FFMPEG_HWACCEL=cuda
FFMPEG_VIDEO_CODEC=h264_nvenc
FFMPEG_VIDEO_BITRATE=18M

# ===== Optional AI upscaling (Real-ESRGAN NCNN Vulkan) =====
# Enable post-render upscaling stage
UPSCALING_ENABLED=false
# Default points to local project binary: bin/realesrgan-ncnn-vulkan/realesrgan-ncnn-vulkan
UPSCALING_BINARY=bin/realesrgan-ncnn-vulkan/realesrgan-ncnn-vulkan
# Default model folder (must contain .param/.bin files)
UPSCALING_MODEL_DIR=bin/realesrgan-ncnn-vulkan/models
# Approved default (realistic people) for --upscale/--upcale flow
UPSCALING_MODEL=realesr-general-x4v3
UPSCALING_SCALE=2
UPSCALING_TILE_SIZE=128
UPSCALING_THREADS=1:2:2
UPSCALING_GPU_ID=auto
# Keep final output dimensions stable after AI enhancement
UPSCALING_DOWNSCALE_TO_OUTPUT=true
# Face enhancement using bundled Python Real-ESRGAN script (GFPGAN backend)
UPSCALING_FACE_ENHANCE=true
UPSCALING_FACE_MODEL=gfpgan
UPSCALING_PYTHON_SCRIPT=bin/Real-ESRGAN-0.3.0/inference_realesrgan_video.py

# ===== Visual retention =====
VIGNETTE_ENABLED=false
VIGNETTE_ANGLE=0.5
PROGRESS_BAR_ENABLED=false
PROGRESS_BAR_HEIGHT=5
PROGRESS_BAR_MARGIN=14
PROGRESS_BAR_TRACK_COLOR=#FFFFFF
PROGRESS_BAR_FILL_COLOR=#00FF00
EMOJI_ENABLED=false
EMOJI_MAX_EVENTS=4
EMOJI_FONT_SIZE=58
RENDER_PARALLEL_JOBS=1
AUDIO_NORMALIZATION_ENABLED=true
AUDIO_TARGET_LUFS=-14.0
YTDLP_CONCURRENT_FRAGMENTS=4
YTDLP_BUFFERSIZE=16M
FFMPEG_NVENC_PRESET=p6

# ===== Pipeline profiles =====
# Profile 3: VRAM Otimizado / Modular
PIPELINE_PROFILE=3
# Jump cuts (silence removal)
SILENCE_JUMP_CUTS_ENABLED=false
SILENCE_NOISE_DB=-40.0
SILENCE_MIN_DURATION_SECONDS=0.8
SILENCE_PADDING_SECONDS=0.15
# Force single-speaker focus + lock
FORCE_SINGLE_LAYOUT=true
SPEAKER_LOCK_PRIORITY_ENABLED=false
SPEAKER_INTERRUPT_HOLD_SECONDS=1.5
SPEAKER_SWITCH_MIN_SECONDS=2.0
# Ultra close-up crop
ULTRA_CROP_ENABLED=false
ULTRA_CROP_FACE_WIDTH_FACTOR=2.5
ULTRA_CROP_MIN_HEIGHT_RATIO=0.60
# Caption transform
CAPTIONS_FORCE_UPPERCASE=false

# ===== Output naming =====
PROJECT_NAME=shorts_pipeline
OUTPUT_BASENAME=clip
SUBTITLES_DIR=data/subtitles

# ===== Runtime/debug =====
LOG_LEVEL=INFO
KEEP_INTERMEDIATE_FILES=true

# Quality pipeline: local ASD and aligned captions
WHISPER_ALIGNMENT=true
FIT_SCENE_FULL_FRAME_MODE=true
CAPTIONS_MAX_CHARS=28
CAPTIONS_ANIMATED=false
CINEMATIC_ZOOM=false
ENRICH_CLIP=false
ASD_DEVICE=auto
ASD_THRESHOLD=0.7
ASD_MARGIN=0.2
ASD_HOLD_SECONDS=0.4
# Optional model ID or complete local directory (avoids Hub probes for local files).
WHISPER_ALIGNMENT_MODEL=
# Retry failed segments once, using at most this many seconds of surrounding silence.
# Set 0 to disable retries; neighbouring speech is never included.
WHISPER_ALIGNMENT_RETRY_PADDING=0.25

# Stage checkpoints and bounded local editorial review (no API spending).
STAGE_CACHE_ENABLED=true
SELECTIVE_ALIGNMENT=true
EDITORIAL_REVIEW_ENABLED=true
EDITORIAL_REVIEW_MAX_CANDIDATES=12
# Paid calls require an exact model name AND explicitly verified prices.
# Zero/missing prices block external calls. Reservations include possible output.
API_BUDGET_USD=0.05
API_MAX_OUTPUT_TOKENS=2048
API_PRICED_MODEL=
API_INPUT_USD_PER_MILLION=0
API_OUTPUT_USD_PER_MILLION=0

# Optional narrative editing; existing camera/caption settings are preserved.
NARRATIVE_EDIT_ENABLED=false
NARRATIVE_MONTAGE_ENABLED=false
HOOK_PREVIEW_ENABLED=false
HOOK_PREVIEW_MAX_SECONDS=12
NARRATIVE_CONTEXT_SECONDS=45
NARRATIVE_MAX_PARTS=6
# Multilingual CPU embeddings; first public download must be explicitly enabled.
SEMANTIC_MONTAGE_ENABLED=false
SEMANTIC_EMBEDDING_MODEL=intfloat/multilingual-e5-small
SEMANTIC_EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
SEMANTIC_ALLOW_DOWNLOAD=false
SEMANTIC_SIMILARITY_THRESHOLD=0.90
SEMANTIC_MAX_PAIRS=12
# Jev (TypeSafe AI) Cognitive Triage, Discovery & Two-Layer Viral Curation
JEV_ENABLED=false
JEV_API_KEY=
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_BUDGET_USD=0.01
JEV_INPUT_USD_PER_MILLION=0.042
JEV_CONFIDENCE_THRESHOLD=0.8
